*.pem
*.key
credentials.json
**/credentials/
**/certs/
**/secrets/

# Greengrass runtime data (Docker volume mount target)
/greengrass/
edge/greengrass-v2/

# Working directory (temporary files and intermediate data)
working/

# Git worktrees (project-local isolated workspaces)
.worktrees/

# Dependencies
node_modules/

