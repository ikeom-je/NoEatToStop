# ============================================================
# edge/.env.example — Edge 環境変数テンプレート
# cp edge/.env.example edge/.env して実際の値を設定する
# edge/.env は .gitignore で追跡除外済み（コミット禁止）
# ============================================================

AWS_REGION=ap-northeast-1

# --- Greengrass Core 設定 ---
THING_NAME=noeatstop-edge-device
THING_GROUP_NAME=noeatstop-devices-dev
# 初回プロビジョニング時は true、2回目以降は false
PROVISION=true
# Token Exchange Role（自動プロビジョニングで作成される）
TES_ROLE_NAME=GreengrassV2TokenExchangeRole
TES_ROLE_ALIAS_NAME=GreengrassV2TokenExchangeRoleAlias

# --- フレームキャプチャ設定 ---
# CDK デプロイ出力の VideoBucketName を設定（必須）
VIDEO_BUCKET=noeatstop-videos-dev-XXXXXXXXXXXX

# フレームキャプチャ間隔（秒）
CAPTURE_INTERVAL=3

# --- AWS 認証情報（frame-capture 用） ---
# Greengrass Core は ~/.aws/credentials をマウントするため不要
# frame-capture コンテナ用に設定
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
# SSO/STS 利用時のみ
# AWS_SESSION_TOKEN=...
