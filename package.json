{
  "name": "no-eat-to-stop-system",
  "version": "0.0.1",
  "description": "System to control TV based on children's eating behavior",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest test --testPathIgnorePatterns=test/integration test/e2e",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest test/integration --testPathIgnorePatterns=tv-api",
    "test:e2e": "node --experimental-vm-modules node_modules/.bin/jest test/e2e --testPathIgnorePatterns=tv-api",
    "test:non-tvapi": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns=tv-api --testPathIgnorePatterns=TVControlService",
    "test:all": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "cdk": "cdk",
    "deploy": "npm run build && cdk deploy",
    "deploy:frontend": "node scripts/deploy-frontend.js",
    "deploy:all": "npm run deploy && npm run deploy:frontend",
    "destroy": "cdk destroy",
    "synth": "cdk synth"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/jest": "^29.5.5",
    "@types/node": "20.6.2",
    "aws-cdk": "2.100.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "~5.2.2"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.400.0",
    "@aws-sdk/client-cloudformation": "^3.400.0",
    "@aws-sdk/client-cloudwatch": "^3.914.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.914.0",
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-iot-data-plane": "^3.914.0",
    "@aws-sdk/client-kinesis-video": "^3.400.0",
    "@aws-sdk/client-rekognition": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "aws-cdk-lib": "2.100.0",
    "axios": "^1.12.2",
    "constructs": "^10.0.0",
    "dotenv": "^16.3.1",
    "mime-types": "^2.1.35"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
    ],
    "roots": [
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "!lib/**/*.d.ts",
      "!lib/**/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000
  }
}
